{
  "_note": "Synthetic test case. Every entity, document and number is fictional.",
  "allegation": {
    "id": "STEG-2026-07-21-SYNTHETIC",
    "text": "Synthetic scenario (all entities fictional). The 21/07/2026 outage was caused by a production deficit. A state-funded 450 MW expansion (market 2026-017) was awarded without competitive tender to Société Zeta Travaux at an inflated price, nothing was built, and funds were misappropriated through a link between the contractor and the signing official.",
    "subject": "STEG / Ministry of Energy (fictional scenario)",
    "claim_type": "corruption_procurement",
    "subclaims": [
      {
        "id": "C1",
        "statement": "A major power outage occurred on 21/07/2026.",
        "verification_questions": [
          "Is the outage documented by a source independent of STEG?"
        ],
        "event_date": "2026-07-21T00:00:00Z"
      },
      {
        "id": "C2",
        "statement": "Peak electricity demand in 2026 rose significantly (more than 5%) over 2025.",
        "verification_questions": [
          "What were the 2025 and 2026 annual peaks in INS or grid operator data?",
          "Was summer 2026 exceptionally hot?"
        ]
      },
      {
        "id": "C3",
        "statement": "A funded capacity-expansion project (market 2026-017) existed before the outage.",
        "verification_questions": [
          "Is there an archived JORT or TUNEPS award notice with amount and date?",
          "Does a funder record the same project?"
        ],
        "attested_before": "2026-07-21T00:00:00Z",
        "expected_records": [
          {
            "description": "Award notice for market 2026-017 in the JORT",
            "register_id": "jort",
            "absence_means": "contradicts"
          }
        ]
      },
      {
        "id": "C4",
        "statement": "No capacity has been added on the project site since the award.",
        "verification_questions": [
          "Are there progress reports?",
          "Do satellite images show construction?",
          "Is there a dated field photo?"
        ],
        "expected_records": [
          {
            "description": "Progress reports or provisional acceptance of the works in the lender's project records",
            "register_id": "funder_records",
            "absence_means": "supports"
          }
        ]
      },
      {
        "id": "C5",
        "statement": "The contract was awarded without a competitive tender.",
        "verification_questions": [
          "Was a tender notice published on TUNEPS before the award?",
          "Was an emergency procedure legally justified?"
        ],
        "expected_records": [
          {
            "description": "TUNEPS tender notice for the Rades-Fictive extension, published before the award",
            "register_id": "tuneps",
            "absence_means": "supports"
          }
        ]
      },
      {
        "id": "C6",
        "statement": "The committed amount exceeds the cost of comparable works by more than 20%.",
        "verification_questions": [
          "What did comparable works cost in prior TUNEPS awards?"
        ]
      },
      {
        "id": "C7",
        "statement": "The contractor is linked to the official who signed the award.",
        "verification_questions": [
          "Who are the contractor's managers and owners in the RNE?",
          "Who signed the award?"
        ]
      },
      {
        "id": "C8",
        "statement": "Project funds were misappropriated.",
        "verification_questions": [
          "Is there any documented use of the disbursed funds?"
        ]
      },
      {
        "id": "C9",
        "statement": "A documented emergency legally justified the direct award (gré à gré).",
        "verification_questions": [
          "Was decree n° 2026-0412 published in the JORT before the award?",
          "Did the audit find the emergency justified?"
        ],
        "bearing": "for",
        "expected_records": [
          {
            "description": "Decree n° 2026-0412 declaring the emergency, in the JORT",
            "register_id": "jort",
            "absence_means": "contradicts"
          }
        ]
      }
    ],
    "hypotheses": [
      {
        "id": "H1",
        "statement": "The outage was caused by a production deficit, not a demand surge.",
        "predicts": {
          "C1": true,
          "C2": false
        },
        "kind": "alternative"
      },
      {
        "id": "H2",
        "statement": "The outage was caused by a demand surge.",
        "predicts": {
          "C1": true,
          "C2": true
        },
        "kind": "alternative"
      },
      {
        "id": "H3",
        "statement": "Expansion funds were diverted through a non-competitive award.",
        "predicts": {
          "C3": true,
          "C4": true,
          "C5": true,
          "C6": true,
          "C9": false
        },
        "kind": "allegation"
      },
      {
        "id": "H4",
        "statement": "The direct award was a lawful emergency procedure.",
        "predicts": {
          "C5": true,
          "C9": true
        },
        "kind": "innocent",
        "explains": "emergency"
      }
    ],
